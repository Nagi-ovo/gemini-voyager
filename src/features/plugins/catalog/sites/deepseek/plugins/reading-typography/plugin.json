{
  "$schema": "https://voyager.nagi.fun/plugin.schema.json",
  "id": "voyager.deepseek-reading-typography",
  "name": "DeepSeek · Reading Typography",
  "version": "1.0.0",
  "description": "Adjust answer text size, line height and paragraph spacing. Table text follows the size; code blocks, block formulas and the composer keep their native style.",
  "i18n": {
    "zh": {
      "name": "DeepSeek · 阅读排版",
      "description": "调整回答正文的字号、行高和段落间距；表格文字随字号缩放；代码块、块级公式和输入框保持原样。",
      "settings": {
        "fontSizeEnabled": {
          "label": "自定义正文字号"
        },
        "fontSize": {
          "label": "正文字号（%）",
          "minLabel": "小",
          "maxLabel": "大"
        },
        "spacingEnabled": {
          "label": "自定义间距"
        },
        "lineHeight": {
          "label": "行高（%）",
          "minLabel": "紧凑",
          "maxLabel": "宽松"
        },
        "paragraphSpacing": {
          "label": "段落间距（px）",
          "minLabel": "紧凑",
          "maxLabel": "宽松"
        }
      }
    },
    "zh_TW": {
      "name": "DeepSeek · 閱讀排版",
