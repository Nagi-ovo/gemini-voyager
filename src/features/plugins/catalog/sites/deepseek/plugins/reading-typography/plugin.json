      "settings": {
        "fontSizeEnabled": {
          "label": "自訂正文字級"
        },
        "fontSize": {
          "label": "正文字級（%）",
          "minLabel": "小",
          "maxLabel": "大"
        },
        "spacingEnabled": {
          "label": "自訂間距"
        },
        "lineHeight": {
          "label": "行高（%）",
          "minLabel": "緊湊",
