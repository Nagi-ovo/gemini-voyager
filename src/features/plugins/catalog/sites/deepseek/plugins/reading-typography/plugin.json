        },
        "spacingEnabled": {
          "label": "간격 변경"
        },
        "lineHeight": {
          "label": "줄 높이(%)",
          "minLabel": "좁게",
          "maxLabel": "넓게"
        },
        "paragraphSpacing": {
          "label": "문단 간격(px)",
          "minLabel": "좁게",
          "maxLabel": "넓게"
        }
      }
    },
