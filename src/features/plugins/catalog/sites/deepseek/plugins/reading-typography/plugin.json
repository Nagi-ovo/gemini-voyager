          "label": "段落間隔（px）",
          "minLabel": "狭め",
          "maxLabel": "広め"
        }
      }
    },
    "ko": {
      "name": "DeepSeek · 읽기 서식",
      "description": "답변 본문의 글자 크기, 줄 높이, 문단 간격을 조절합니다. 표 글자도 글자 크기를 따르며, 코드 블록, 블록 수식, 입력창은 그대로 유지됩니다.",
      "settings": {
        "fontSizeEnabled": {
          "label": "글자 크기 변경"
        },
        "fontSize": {
          "label": "글자 크기(%)",
          "minLabel": "작게",
