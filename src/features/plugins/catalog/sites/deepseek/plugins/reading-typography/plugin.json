        },
        "lineHeight": {
          "label": "Interlineado (%)",
          "minLabel": "Ajustado",
          "maxLabel": "Amplio"
        },
        "paragraphSpacing": {
          "label": "Espacio entre párrafos (px)",
          "minLabel": "Ajustado",
          "maxLabel": "Amplio"
        }
      }
    },
    "pt": {
      "name": "DeepSeek · Formatação de leitura",
      "description": "Ajusta o tamanho do texto, a altura da linha e o espaço entre parágrafos das respostas. O texto das tabelas acompanha o tamanho; blocos de código, fórmulas em bloco e a caixa de entrada não mudam.",
      "settings": {
        "fontSizeEnabled": {
          "label": "Personalizar tamanho do texto"
